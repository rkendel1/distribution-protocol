{
  "name": "@distribution-protocol/conformance",
  "version": "1.0.0",
  "description": "Executable protocol conformance suite: the definition of a conformant Distribution Protocol implementation",
  "keywords": [
    "distribution-protocol",
    "conformance",
    "test-suite",
    "registry"
  ],
  "homepage": "https://github.com/rkendel1/distribution-protocol/tree/master/packages/conformance#readme",
  "bugs": {
    "url": "https://github.com/rkendel1/distribution-protocol/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkendel1/distribution-protocol.git",
    "directory": "packages/conformance"
  },
  "license": "MIT",
  "author": "Distribution Protocol contributors",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./registry-suite": "./src/registry-suite.mjs",
    "./publisher-suite": "./src/publisher-suite.mjs",
    "./artifact-content-suite": "./src/artifact-content-suite.mjs",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "!src/**/*.test.mjs"
  ],
  "scripts": {
    "test": "node --test src/*.test.mjs",
    "prepublishOnly": "node ../../scripts/guard-publish.mjs"
  },
  "dependencies": {
    "@distribution-protocol/protocol": "^1.0.0",
    "@distribution-protocol/registry": "^1.0.0"
  },
  "engines": {
    "node": ">=18.17"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@distribution-protocol/workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Distribution Protocol \u2014 publish once, verify everywhere, resolve anywhere",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:conformance": "node --test packages/conformance/src/*.test.mjs",
    "test:cli": "node --test packages/cli/src/*.test.mjs",
    "generate:spec": "node scripts/generate-spec.mjs",
    "publish:packages": "node scripts/publish-packages.mjs",
    "publish:dry-run": "node scripts/publish-packages.mjs --dry-run"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkendel1/distribution-protocol.git"
  }
}

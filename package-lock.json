{
  "name": "@distribution-protocol/workspace",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@distribution-protocol/workspace",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@distribution-protocol/protocol": {
      "resolved": "packages/protocol",

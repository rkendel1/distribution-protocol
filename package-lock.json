    },
    "node_modules/@distribution-protocol/registry": {
      "resolved": "packages/registry",
      "link": true
    },
    "packages/protocol": {
      "name": "@distribution-protocol/protocol",
      "version": "0.1.0"
    },
    "packages/registry": {
      "name": "@distribution-protocol/registry",
      "version": "0.1.0"
    }
  }
}

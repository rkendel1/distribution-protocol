{
  "name": "@distribution-protocol/workspace",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@distribution-protocol/workspace",
      "version": "1.0.0",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=18.17"
      }
    },
    "node_modules/@distribution-protocol/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@distribution-protocol/conformance": {
      "resolved": "packages/conformance",
      "link": true
    },
    "node_modules/@distribution-protocol/protocol": {
      "resolved": "packages/protocol",
      "link": true
    },
    "node_modules/@distribution-protocol/registry": {
      "resolved": "packages/registry",
      "link": true
    },
    "packages/cli": {
      "name": "@distribution-protocol/cli",
      "version": "1.0.0",
      "license": "MIT",
      "dependencies": {
        "@distribution-protocol/protocol": "1.0.0",
        "@distribution-protocol/registry": "1.0.0"
      },
      "bin": {
        "distribution": "bin/distribution.mjs"
      },
      "engines": {
        "node": ">=18.17"
      }
    },
    "packages/conformance": {
      "name": "@distribution-protocol/conformance",
      "version": "1.0.0",
      "license": "MIT",
      "dependencies": {
        "@distribution-protocol/protocol": "1.0.0",
        "@distribution-protocol/registry": "1.0.0"
      },
      "engines": {
        "node": ">=18.17"
      }
    },
    "packages/protocol": {
      "name": "@distribution-protocol/protocol",
      "version": "1.0.0",
      "license": "MIT",
      "engines": {
        "node": ">=18.17"
      }
    },
    "packages/registry": {
      "name": "@distribution-protocol/registry",
      "version": "1.0.0",
      "license": "MIT",
      "dependencies": {
        "@distribution-protocol/protocol": "1.0.0"
      },
      "engines": {
        "node": ">=18.17"
      }
    }
  }
}
